# ==============================================
# 🔧 ARCHIVO DE EJEMPLO DE VARIABLES DE ENTORNO
# ==============================================
# 
# Copia este archivo como .env y completa los valores reales
# 
# ⚠️ IMPORTANTE: Nunca subas el archivo .env a GitHub
# ⚠️ Este archivo (.env.example) NO contiene valores reales
#

# ==============================================
# 📊 BASE DE DATOS
# ==============================================

# PostgreSQL Connection String
# Formato: postgresql://usuario:contraseña@host:puerto/nombre_db
# 
# Desarrollo local:
DATABASE_URL="postgresql://postgres:password@localhost:5432/izacas_ecommerce"
# 
# Docker (docker-compose):
# DATABASE_URL="postgresql://izacas:izacas2024@database:5432/izacas?schema=public"
#
# Railway (se genera automáticamente):
# DATABASE_URL="${{Postgres.DATABASE_URL}}"

# ==============================================
# 🔐 NEXTAUTH (AUTENTICACIÓN)
# ==============================================

# Secret para JWT (OBLIGATORIO en producción)
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="your-secret-here-change-in-production"

# URL de tu aplicación
# Desarrollo:
NEXTAUTH_URL="http://localhost:3000"
# Producción Railway:
# NEXTAUTH_URL="https://tu-app.up.railway.app"
# Dominio personalizado:
# NEXTAUTH_URL="https://www.izacas.cl"

# ==============================================
# 💳 TRANSBANK WEBPAY PLUS
# ==============================================

# Modo Integración (Testing)
# Transbank proporciona credenciales de prueba públicas
# Consulta la documentación: https://www.transbankdevelopers.cl/
TRANSBANK_COMMERCE_CODE="tu-codigo-de-comercio-o-usa-el-de-prueba"
TRANSBANK_API_KEY="tu-api-key-o-usa-la-de-prueba"
TRANSBANK_ENVIRONMENT="integration"

# Modo Producción (Cuando estés listo para producción)
# TRANSBANK_COMMERCE_CODE="tu-codigo-de-comercio-real"
# TRANSBANK_API_KEY="tu-api-key-de-produccion"
# TRANSBANK_ENVIRONMENT="production"

# URLs de retorno (cambiar según tu dominio)
TRANSBANK_RETURN_URL="http://localhost:3000/checkout/return"
TRANSBANK_FINAL_URL="http://localhost:3000/checkout/success"
# En producción:
# TRANSBANK_RETURN_URL="https://tu-dominio.com/checkout/return"
# TRANSBANK_FINAL_URL="https://tu-dominio.com/checkout/success"

# ==============================================
# 📦 CHILEXPRESS (ENVÍOS) - OPCIONAL
# ==============================================

# Si tienes cuenta en Chilexpress, configura aquí
# Si no tienes, la app usará valores de fallback
CHILEXPRESS_API_KEY="tu-api-key-aqui"
CHILEXPRESS_API_URL="https://testservices.wschilexpress.com"

# En producción:
# CHILEXPRESS_API_URL="https://services.wschilexpress.com"

# ==============================================
# 🗺️ GOOGLE MAPS - OPCIONAL
# ==============================================

# Para autocompletar direcciones
# Obtén tu API Key en: https://console.cloud.google.com/
# Ver guía completa en: GOOGLE-MAPS-SETUP.md
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="tu-google-maps-api-key"

# ==============================================
# 🏪 CONFIGURACIÓN DE TIENDA
# ==============================================

# Información pública de la tienda (reemplazar con tus datos)
NEXT_PUBLIC_STORE_NAME="Mi Tienda E-commerce"
NEXT_PUBLIC_STORE_ADDRESS="Calle Principal 123, Santiago, Chile"
NEXT_PUBLIC_STORE_PHONE="+56912345678"
NEXT_PUBLIC_STORE_EMAIL="contacto@mitienda.cl"

# ==============================================
# ⚙️ CONFIGURACIÓN DE NODE.JS
# ==============================================

# Entorno de ejecución
NODE_ENV="development"  # En producción cambiar a "production"

# Puerto (Railway lo asigna automáticamente)
PORT=3000

# API URL (para desarrollo local)
NEXT_PUBLIC_API_URL="http://localhost:3000"

# ==============================================
# 📧 EMAIL (OPCIONAL - PARA FUTURAS MEJORAS)
# ==============================================

# Si quieres agregar notificaciones por email
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="tu-email@gmail.com"
# SMTP_PASSWORD="tu-password-de-app"

# ==============================================
# 📊 ANALYTICS (OPCIONAL)
# ==============================================

# Google Analytics
# NEXT_PUBLIC_GA_TRACKING_ID="G-XXXXXXXXXX"

# ==============================================
# 🔒 SEGURIDAD (OPCIONAL)
# ==============================================

# Rate limiting (ya implementado en código)
# RATE_LIMIT_MAX_REQUESTS="100"
# RATE_LIMIT_WINDOW_MS="60000"

# ==============================================
# 🐛 DEBUG (SOLO DESARROLLO)
# ==============================================

# Logs detallados de Prisma
# DEBUG="prisma:*"

# ==============================================
# 📝 NOTAS IMPORTANTES
# ==============================================
# 
# 1. En Railway, las variables se configuran en el dashboard
#    No necesitas subir el archivo .env a Railway
# 
# 2. Para generar AUTH_SECRET seguro:
#    node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 
# 3. Railway genera DATABASE_URL automáticamente al agregar PostgreSQL
# 
# 4. Transbank está en modo "integration" por defecto (testing)
#    Cambia a "production" cuando estés listo para producción real
# 
# 5. Chilexpress y Google Maps son opcionales
#    La app funciona sin ellos usando fallbacks
# 
# 6. Verifica que NEXTAUTH_URL coincida con tu URL real en producción
# 
# 7. Nunca compartas AUTH_SECRET, TRANSBANK_API_KEY o claves reales
# 
# ==============================================
