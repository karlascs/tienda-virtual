# ========================================
# DOCKERFILE PARA BACKEND API - IZA&CAS
# ========================================
# 
# Construye imagen Docker optimizada para el servidor API backend.
# Usa arquitectura multi-stage para reducir tamaño final de imagen.
# 
# Servicios incluidos:
# - Next.js API Routes (backend)
# - Prisma Client (acceso a PostgreSQL)
# - Express server personalizado (server.js)
# 
# Puerto: 3001
# Tamaño final: ~400MB (con optimizaciones)
# ========================================

# ========================================
# STAGE 1: BUILDER
# Compilación y build del código
# ========================================
FROM node:22-alpine AS builder

WORKDIR /app

# Copiar archivos de configuración del proyecto
COPY package*.json ./
COPY tsconfig.json ./
COPY next.config.ts ./
COPY prisma ./prisma/
COPY scripts ./scripts/

# Instalar TODAS las dependencias (incluyendo devDependencies para build)
RUN npm ci

# Generar Prisma Client basado en schema.prisma
# Esto crea los tipos TypeScript y el cliente de base de datos
RUN npx prisma generate

# Copiar código fuente de la aplicación
COPY src ./src
COPY public ./public
COPY server.js ./
COPY *.config.* ./

# Compilar aplicación Next.js
# Genera .next/standalone (build optimizado para producción)
RUN npm run build

# ========================================
# STAGE 2: RUNNER
# Imagen final optimizada para producción
# ========================================
FROM node:22-alpine AS runner

WORKDIR /app

# Variables de entorno para producción
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3001

# Crear usuario no-root para seguridad
# No ejecutar como root dentro del contenedor
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

# Copiar archivos necesarios desde builder
# Solo lo esencial para ejecutar, no todo el código fuente
COPY --from=builder --chown=nextjs:nodejs /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=nextjs:nodejs /app/prisma ./prisma
COPY --from=builder --chown=nextjs:nodejs /app/server.js ./server.js

# Cambiar a usuario no-root
USER nextjs

# Exponer puerto del backend
EXPOSE 3001

# Comando de inicio
# Ejecuta el servidor Express directamente (sin migraciones automáticas)
# Las migraciones deben ejecutarse manualmente antes del deployment
CMD ["node", "server.js"]
